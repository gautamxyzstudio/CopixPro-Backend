{
  "kind": "collectionType",
  "collectionName": "coupons",
  "info": {
    "singularName": "coupon",
    "pluralName": "coupons",
    "displayName": "coupon"
  },
  "options": {
    "draftAndPublish": false
  },
  "pluginOptions": {},
  "attributes": {
    "name": {
      "type": "string"
    },
    "description": {
      "type": "text"
    },
    "code": {
      "type": "string"
    },
    "discountType": {
      "type": "enumeration",
      "enum": [
        "percentage",
        "flat"
      ],
      "default": "percentage"
    },
    "discountPercentage": {
      "type": "decimal"
    },
    "flatDiscount": {
      "type": "decimal"
    },
    "maxUses": {
      "type": "integer"
    },
    "usedCount": {
      "type": "integer",
      "default": 0
    },
    "isActive": {
      "type": "boolean",
      "default": true
    },
    "paymentLink": {
      "type": "string"
    },
    "orders": {
      "type": "relation",
      "relation": "oneToMany",
      "target": "api::order.order",
      "mappedBy": "coupon"
    }
  }
}
